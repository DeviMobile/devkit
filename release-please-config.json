{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "dart",
  "separate-pull-requests": true,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    "packages/devimobile_devkit_cli": {
      "component": "devimobile_devkit_cli"
    },
    "packages/devimobile_devkit_lints": {
      "component": "devimobile_devkit_lints"
    },
    "packages/devimobile_devkit_rules": {
      "component": "devimobile_devkit_rules"
    }
  }
}
